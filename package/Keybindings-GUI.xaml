<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AC7 · 键位设置" Width="860" Height="760" MinWidth="680" MinHeight="560" WindowStartupLocation="CenterOwner" Background="{DynamicResource CxBg}" Foreground="{DynamicResource CxText}" FontFamily="{DynamicResource CxSans}" FontSize="13" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="12,6"/><Setter Property="Background" Value="{DynamicResource CxRaised}"/><Setter Property="Foreground" Value="{DynamicResource CxText}"/><Setter Property="BorderBrush" Value="{DynamicResource CxBoundary}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource CxAccent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource CxAccent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="Tag" Value="primary"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource CxAccent}"/><Setter Property="Foreground" Value="{DynamicResource CxOnAccent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Viewbox Margin="24" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top"><Grid Width="780"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><StackPanel Orientation="Horizontal"><Border Width="3" Background="{DynamicResource CxAccentMark}" Margin="0,0,10,0"/><TextBlock Text="CREEPERUX / AC7" FontFamily="{DynamicResource CxDisplay}" FontSize="17"/></StackPanel><TextBlock Text="观察与手动接管键位" FontSize="23" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="点击按键后直接按键录入；Esc 取消录入。此页支持单键，不改变游戏键位，只写入 Mod 的 config.ini。" TextWrapping="Wrap" Foreground="{DynamicResource CxMuted}"/></StackPanel>
  <Border Grid.Row="1" Background="{DynamicResource CxPanel}" BorderBrush="{DynamicResource CxLine}" BorderThickness="1" CornerRadius="6" Padding="18"><StackPanel x:Name="BindingRows"/></Border>
  <Border Grid.Row="2" Background="{DynamicResource CxRaised}" CornerRadius="4" Padding="14" Margin="0,14,0,0"><StackPanel><TextBlock Text="姿态接管检测键需要与 AC7 游戏内的操纵绑定一致（默认 W/S 俯仰、A/D 滚转、Q/E 偏航）。" TextWrapping="Wrap"/><TextBlock Text="油门和减速仍由游戏控制。Shift／Ctrl 等绑定也可能与游戏功能或已有组合键同时生效。" TextWrapping="Wrap" Foreground="{DynamicResource CxMuted}" Margin="0,6,0,0"/></StackPanel></Border>
  <TextBlock x:Name="BindingStatus" Grid.Row="3" Text="保存后写入本包与已安装的 config.ini，下次启动生效；F1–F10 快捷键保持不变。" TextWrapping="Wrap" Foreground="{DynamicResource CxMuted}" Margin="0,14,0,0" MinHeight="40"/>
  <Grid Grid.Row="4" Margin="0,12,0,0"><Button x:Name="RestoreBindings" Content="恢复默认（待保存）" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelBindings" Content="取消" Margin="0,0,8,0"/><Button x:Name="SaveBindings" Content="保存，下次启动生效" Tag="primary"/></StackPanel></Grid>
 </Grid></Viewbox>
</Window>
