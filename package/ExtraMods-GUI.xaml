<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AC7 · 附加 Mod" Width="860" Height="720" MinWidth="640" MinHeight="520" WindowStartupLocation="CenterOwner" Background="{DynamicResource CxBg}" Foreground="{DynamicResource CxText}" FontFamily="{DynamicResource CxSans}" FontSize="13" UseLayoutRounding="True" AllowDrop="True">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="12,6"/><Setter Property="Background" Value="{DynamicResource CxRaised}"/><Setter Property="Foreground" Value="{DynamicResource CxText}"/><Setter Property="BorderBrush" Value="{DynamicResource CxBoundary}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource CxAccent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource CxAccent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="Tag" Value="primary"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource CxAccent}"/><Setter Property="Foreground" Value="{DynamicResource CxOnAccent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="CREEPERUX / AC7" FontFamily="{DynamicResource CxDisplay}" FontSize="17"/><TextBlock Text="附加 UE4SS Mod" FontSize="23" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="这些 Mod 由本工具放进游戏的 ue4ss\Mods，随本包的 UE4SS 一起加载；每次改动后自动同步（需要关闭游戏）。你手动放进游戏的 Mod 不受影响。只安装可信来源的 Mod。" TextWrapping="Wrap" Foreground="{DynamicResource CxMuted}"/></StackPanel>
  <Border Grid.Row="1" Background="{DynamicResource CxPanel}" BorderBrush="{DynamicResource CxLine}" BorderThickness="1" CornerRadius="6" Padding="18,14"><Grid>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ModRows"/></ScrollViewer>
   <TextBlock x:Name="EmptyHint" Text="还没有附加 Mod。点击下方的“添加 zip”或“添加文件夹”，也可以把 zip 或文件夹直接拖到这个窗口。" TextWrapping="Wrap" Foreground="{DynamicResource CxMuted}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="520"/>
  </Grid></Border>
  <Border Grid.Row="2" Background="{DynamicResource CxRaised}" CornerRadius="4" Padding="14" Margin="0,14,0,0"><StackPanel><TextBlock Text="支持 .zip 压缩包或已解压的文件夹（7z／rar 请先解压）。会自动找到含 Scripts\main.lua 或 dlls\main.dll 的 Mod 文件夹；压缩包里的 UE4SS 本体和 .pak 资源不会安装。" TextWrapping="Wrap"/><TextBlock Text="停用会把 Mod 从游戏中移走（Mod 库里保留，文件夹名前加 _）；删除的 Mod 移到 ue4ss-mods-removed，需要时可以移回。游戏里同名、但不是本工具放的文件夹不会被覆盖。" TextWrapping="Wrap" Foreground="{DynamicResource CxMuted}" Margin="0,6,0,0"/></StackPanel></Border>
  <TextBlock x:Name="ModStatus" Grid.Row="3" Text="改动会同步到游戏，下次启动游戏时生效。" TextWrapping="Wrap" Foreground="{DynamicResource CxMuted}" Margin="0,14,0,0" MinHeight="40"/>
  <Grid Grid.Row="4" Margin="0,12,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button x:Name="AddModZip" Content="添加 zip…" Margin="0,0,8,0"/><Button x:Name="AddModFolder" Content="添加文件夹…" Margin="0,0,8,0"/><Button x:Name="SyncMods" Content="同步到游戏" Margin="0,0,8,0"/><Button x:Name="OpenModsFolder" Content="打开 Mod 库"/></StackPanel><Button x:Name="CloseMods" Content="完成" Tag="primary" HorizontalAlignment="Right"/></Grid>
 </Grid>
</Window>
