<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AC7 · 飞控设置" Width="940" Height="860" MinWidth="700" MinHeight="560" WindowStartupLocation="CenterOwner" Background="{DynamicResource CxBg}" Foreground="{DynamicResource CxText}" FontFamily="{DynamicResource CxSans}" FontSize="13" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="12,6"/><Setter Property="Background" Value="{DynamicResource CxRaised}"/><Setter Property="Foreground" Value="{DynamicResource CxText}"/><Setter Property="BorderBrush" Value="{DynamicResource CxBoundary}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource CxAccent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource CxAccent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="Tag" Value="primary"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource CxAccent}"/><Setter Property="Foreground" Value="{DynamicResource CxOnAccent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox">
   <Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="8,3"/><Setter Property="Background" Value="{DynamicResource CxDeep}"/><Setter Property="Foreground" Value="{DynamicResource CxText}"/><Setter Property="CaretBrush" Value="{DynamicResource CxText}"/><Setter Property="BorderBrush" Value="{DynamicResource CxBoundary}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontFamily" Value="{DynamicResource CxMono}"/><Setter Property="SelectionBrush" Value="{DynamicResource CxAccentSoft}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource CxFocus}"/><Setter TargetName="Edge" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource CxText}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal" Background="Transparent"><Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="{DynamicResource CxDeep}" BorderBrush="{DynamicResource CxBoundary}" BorderThickness="1"><Path x:Name="Mark" Data="M3,8.5 L6.5,12 L13,4.5" Stroke="{DynamicResource CxOnAccent}" StrokeThickness="2" Visibility="Collapsed"/></Border><ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CxAccent}"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource CxAccent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CxAccent}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CxFocus}"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource CxText}"/><Setter Property="MinHeight" Value="30"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="8"/><Setter Property="Foreground" Value="{DynamicResource CxText}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource CxAccentSoft}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource CxDeep}" BorderBrush="{DynamicResource CxBoundary}" BorderThickness="1" CornerRadius="5"><TextBlock Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource CxMuted}"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" Margin="8,0,24,0"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border Background="{DynamicResource CxRaised}" BorderBrush="{DynamicResource CxBoundary}" BorderThickness="1" CornerRadius="5" MinWidth="170"><ScrollViewer MaxHeight="200"><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{DynamicResource CxPanel}"/><Setter Property="BorderBrush" Value="{DynamicResource CxLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="18,16"/></Style>
  <Style x:Key="Kicker" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource CxMono}"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource CxQuiet}"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,4,0,14"/></Style>
 </Window.Resources>
 <Viewbox Margin="24" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top"><Grid Width="860"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><StackPanel Orientation="Horizontal"><Border Width="3" Background="{DynamicResource CxAccentMark}" Margin="0,0,10,0"/><TextBlock Text="CREEPERUX / AC7" FontFamily="{DynamicResource CxDisplay}" FontSize="17"/></StackPanel><TextBlock Text="鼠标飞控设置" FontSize="23" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock x:Name="TargetInfo" Text="" TextWrapping="Wrap" Foreground="{DynamicResource CxMuted}"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,8,0">
    <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="01 / CONTROL" Style="{StaticResource Kicker}"/><TextBlock Text="飞控" Style="{StaticResource Heading}"/><StackPanel x:Name="ControlRows"/></StackPanel></Border>
    <Border Style="{StaticResource Panel}" Margin="0,12,0,0"><StackPanel><TextBlock Text="02 / CAMERA" Style="{StaticResource Kicker}"/><TextBlock Text="机位" Style="{StaticResource Heading}"/><StackPanel x:Name="CameraRows"/></StackPanel></Border>
   </StackPanel>
   <StackPanel Grid.Column="1" Margin="8,0,0,0">
    <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="03 / HUD" Style="{StaticResource Kicker}"/><TextBlock Text="圆环与准星" Style="{StaticResource Heading}"/><StackPanel x:Name="HudRows"/></StackPanel></Border>
    <Border Style="{StaticResource Panel}" Margin="0,12,0,0"><StackPanel><TextBlock Text="04 / ASSIST" Style="{StaticResource Kicker}"/><TextBlock Text="制动辅助" Style="{StaticResource Heading}"/><StackPanel x:Name="AssistRows"/></StackPanel></Border>
   </StackPanel>
  </Grid>
  <TextBlock x:Name="SettingsStatus" Grid.Row="2" Text="关闭游戏后保存。游戏内 Ctrl+PageUp／PageDown 的灵敏度调整只作用于本次运行。" TextWrapping="Wrap" Foreground="{DynamicResource CxMuted}" Margin="0,14,0,0" MinHeight="40"/>
  <Grid Grid.Row="3" Margin="0,10,0,0"><Button x:Name="RestoreSettings" Content="恢复默认（待保存）" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelSettings" Content="取消" Margin="0,0,8,0"/><Button x:Name="SaveSettings" Content="保存，下次启动生效" Tag="primary"/></StackPanel></Grid>
 </Grid></Viewbox>
</Window>
